{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "Disconnected"}, "1": {"color": "green", "text": "Connected"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "auto"},
      "targets": [{"expr": "max(nexus_ws_connected)", "refId": "A"}],
      "title": "Active Source Connection",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 15}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "nexus_market_data_age_seconds", "legendFormat": "{{source}} · {{market}}", "refId": "A"}],
      "title": "Market Data Age",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 3,
      "targets": [{"expr": "nexus_market_mid_price", "legendFormat": "{{source}} · {{market}}", "refId": "A"}],
      "title": "Mid Price",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 4,
      "targets": [{"expr": "nexus_market_spread_bps", "legendFormat": "{{source}} · {{market}}", "refId": "A"}],
      "title": "Spread (basis points)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 1, "min": -1}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 5,
      "targets": [{"expr": "nexus_market_imbalance", "legendFormat": "{{source}} · {{market}}", "refId": "A"}],
      "title": "Order Book Imbalance",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 8},
      "id": 6,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(nexus_ws_reconnects_total)", "refId": "A"}],
      "title": "Reconnects",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 8},
      "id": 7,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(nexus_ws_lagged_frames_total)", "refId": "A"}],
      "title": "Sequence Gaps / Lagged Frames",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 8},
      "id": 8,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(nexus_snapshots_persisted_total)", "refId": "A"}],
      "title": "Snapshots Persisted",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 9,
      "targets": [{"expr": "sum by (route) (rate(nexus_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A"}],
      "title": "HTTP Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 10,
      "targets": [{"expr": "max by (route) (nexus_http_request_duration_seconds{quantile=\"0.95\"})", "legendFormat": "p95 {{route}}", "refId": "A"}],
      "title": "API Latency (p95)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["nexus", "market-data", "rust"],
  "templating": {"list": []},
  "time": {"from": "now-5m", "to": "now"},
  "timezone": "browser",
  "title": "Nexus Market Observer",
  "uid": "nexus-market-observer",
  "version": 2
}
